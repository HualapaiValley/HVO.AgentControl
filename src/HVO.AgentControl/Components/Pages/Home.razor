@page "/"
@namespace HVO.AgentControl.Components.Pages

<PageTitle>AgentControl V2</PageTitle>

<div class="portal" data-portal data-runtime-state="unknown">
    <a class="skip-link" href="#portal-content">Skip to organization</a>
    <header class="app-bar">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"><span class="brand-led"></span></span>
            <span class="brand-copy">
                <h1 class="brand-name">AgentControl <em>V2</em></h1>
                <span class="brand-org" data-field="organizationName">AgentControl Development</span>
            </span>
        </div>
        <dl class="app-bar-meta" aria-label="Runtime summary">
            <div class="meta-item"><dt>Runtime</dt><dd><span class="state-pill" data-field="state" data-state="unknown"><span class="state-led" aria-hidden="true"></span><span class="state-text">Synchronizing</span></span></dd></div>
            <div class="meta-item"><dt>Selected employee</dt><dd data-selected-employee-name>None</dd></div>
            <div class="meta-item"><dt>Native session</dt><dd><code class="mono" data-field="sessionId">&mdash;</code></dd></div>
            <div class="meta-item"><dt>Session model</dt><dd><code class="mono" data-field="model">&mdash;</code></dd></div>
        </dl>
    </header>

    <p class="error-banner" data-field="error-banner" role="alert" hidden><span class="error-tag">Runtime fault</span><span class="error-text" data-field="error"></span></p>

    <main class="workspace" id="portal-content" tabindex="-1">
        <aside class="organization-nav" aria-label="Organization navigation">
            <button type="button" class="nav-item" data-nav="overview" aria-current="page">Overview</button>
            <button type="button" class="nav-item" data-nav="operations">Operations</button>
            <button type="button" class="nav-item" data-nav="development">Development</button>
            <button type="button" class="nav-item" data-nav="qa">QA</button>
            <button type="button" class="nav-item" data-nav="system">System configuration</button>
        </aside>

        <section class="organization-area" data-org-overview aria-live="polite">
            <p class="org-state" data-org-state>Loading authoritative organization diagnostics&hellip;</p>

            <section class="org-view" data-view="overview" aria-labelledby="overview-title">
                <h2 id="overview-title">Organization overview</h2>
                <p class="lead" data-org-description>&mdash;</p>
                <p data-org-basic-instructions>&mdash;</p>
                <div class="summary-grid">
                    <article class="summary-card"><h3>Departments</h3><dl data-org-departments></dl></article>
                    <article class="summary-card"><h3>Availability</h3><dl data-org-availability></dl></article>
                    <article class="summary-card"><h3>Pending owner approvals</h3><p data-pending-approvals>Unavailable</p></article>
                </div>
                <article class="attention"><h3>Failures needing attention</h3><ul data-org-failures></ul></article>
            </section>

            <div data-department-views></div>

            <section class="org-view" data-view="employee" hidden aria-labelledby="employee-title">
                <button type="button" class="text-button" data-back-to-department>Back to department</button>
                <h2 id="employee-title" data-employee-name>Employee</h2>
                <p><span class="availability-pill" data-employee-availability>unknown</span></p>
                <div class="detail-grid">
                    <article><h3>Identity and instructions</h3><dl data-employee-identity></dl></article>
                    <article><h3>Runtime binding</h3><dl data-employee-runtime></dl></article>
                    <article><h3>Orientation</h3><dl data-employee-orientation></dl></article>
                    <article><h3>Safe diagnostics</h3><dl data-employee-diagnostics></dl></article>
                </div>
                <div class="orientation-actions">
                    <button type="button" class="btn" data-orientation-deliver disabled>Recompose &amp; deliver</button>
                    <button type="button" class="btn" data-orientation-comprehension disabled>Run comprehension</button>
                    <button type="button" class="btn" data-orientation-hold disabled>Set manual hold</button>
                </div>
                <p class="receipt" data-orientation-receipt role="status"></p>
            </section>

            <section class="org-view" data-view="system" hidden aria-labelledby="system-title">
                <h2 id="system-title">System configuration</h2>
                <p>Persisted changes use current revision tokens. Changes await redelivery, runtime restart or comprehension before readiness returns.</p>
                <form data-org-name-form>
                    <label for="org-name">Company display name</label>
                    <input id="org-name" data-org-name-input data-organization-control required maxlength="128" disabled />
                    <button class="btn" type="submit" data-organization-control disabled>Save display name</button>
                </form>
                <form data-org-instructions-form>
                    <label for="org-instructions">Organization basic instructions</label>
                    <textarea id="org-instructions" data-org-instructions data-organization-control rows="6" required disabled></textarea>
                    <button class="btn" type="submit" data-organization-control disabled>Save basic instructions</button>
                </form>
                <form data-role-instructions-form>
                    <label for="role-select">Authoritative role</label>
                    <select id="role-select" data-role-select data-organization-control disabled></select>
                    <label for="role-instructions">Selected role standing instructions</label>
                    <textarea id="role-instructions" data-role-instructions data-organization-control rows="6" required disabled></textarea>
                    <button class="btn" type="submit" data-organization-control disabled>Save role instructions</button>
                </form>
                <p class="receipt" data-config-receipt role="status"></p>
            </section>
        </section>

        <section class="control-deck" aria-label="Selected employee control console">
            <section class="telemetry">
                <h2 class="panel-title">Selected employee control</h2>
                <dl class="telemetry-grid">
                    <div class="telemetry-row"><dt>Employee</dt><dd data-selected-employee-name>None selected</dd></div>
                    <div class="telemetry-row"><dt>Runtime state</dt><dd data-field="state-detail">Synchronizing</dd></div>
                    <div class="telemetry-row"><dt>Native session</dt><dd><code class="mono" data-field="sessionId">&mdash;</code></dd></div>
                    <div class="telemetry-row"><dt>Transport</dt><dd><code class="mono" data-field="transport">ACP</code></dd></div>
                    <div class="telemetry-row telemetry-row--model">
                        <dt><label for="model-select">Session model</label></dt>
                        <dd class="model-control">
                            <select id="model-select" class="model-select" data-model-select disabled>
                                <option value="" disabled selected>Synchronizing&hellip;</option>
                            </select>
                            <p class="model-receipt" data-model-receipt role="status" aria-live="polite" hidden></p>
                            <p class="control-note" data-model-sync-note hidden>OpenCode's TUI picker is client-local. This is the server session model, not an immediate mirror of the picker. Web selection is unavailable until both can synchronize.</p>
                        </dd>
                    </div>
                    <div class="telemetry-row"><dt>Last sync</dt><dd><time data-field="syncedAt">&mdash;</time></dd></div>
                </dl>
                <div class="controls" role="group" aria-label="Terminal controls">
                    <button type="button" class="btn btn-primary" data-action="reconnect" disabled>Reconnect terminal</button>
                    <button type="button" class="btn" data-action="detach" disabled>Detach</button>
                    <button type="button" class="btn" data-action="clear">Clear view</button>
                    <button type="button" class="btn btn-interrupt" data-action="interrupt" disabled>Interrupt turn</button>
                </div>
                <p class="receipt" data-field="receipt" role="status"></p>
            </section>
            <section class="terminal-surface" id="terminal-surface" aria-labelledby="terminal-title">
                <div class="terminal-head"><div class="terminal-heading"><span class="terminal-lamp" data-connection-led aria-hidden="true"></span><h2 id="terminal-title" class="terminal-title">Selected employee native terminal</h2><span class="terminal-link-state" data-field="connection">Idle</span></div></div>
                <div class="terminal-stage" data-field="terminal-stage">
                    <div id="terminal" class="terminal-mount" data-terminal tabindex="0" role="application" aria-label="Interactive selected employee terminal session"></div>
                    <div class="terminal-overlay" data-field="terminal-overlay"><span class="spinner" aria-hidden="true"></span><span data-field="overlay-text">Select an employee</span></div>
                </div>
            </section>
        </section>
    </main>

    <footer class="app-foot"><span>AgentControl V2 &middot; @HVO.AgentControl.ApplicationVersion.Current &middot; owner workspace</span><span class="mono">GET /api/organization/portal &middot; GET /api/employees/{id}</span></footer>
</div>

<script type="module" src="/js/organization.js"></script>
