@page "/{**Path}"
@namespace HVO.AgentControl.Components.Pages

<PageTitle>Not found · AgentControl V2</PageTitle>
<section class="page" data-page="not-found">
    <header class="page-heading"><div><p class="eyebrow">404</p><h1>Page not found</h1><p>No AgentControl page matches this address.</p></div></header>
    <p class="route-fallback" data-not-found-path>@Path</p>
    <a class="btn btn-primary" href="/organization">Return to organization overview</a>
</section>
