@page "/providers"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits ControlPage

<PageTitle>AgentControl · Model access</PageTitle>
<div class="shell" data-interactive="@RendererInfo.IsInteractive.ToString().ToLowerInvariant()">
    <ControlHeader Title="Model access" Description="Connect execution runtimes to your model subscription." />
    @if (error is not null) { <div class="notice error" role="alert">@error</div> }
    @if (notice is not null) { <div class="notice" role="status">@notice</div> }
    <section class="panel" aria-label="Shared model access">
        <h2>Shared model access</h2>
        <p class="meta">Remaining subscription allowance is unknown. Runtimes using the same provider are conservatively grouped; Go, Zen and ChatGPT have separate groups. These groups do not verify account identity.</p>
        @if (pools.Count == 0) { <p>No provider limits observed.</p> }
        @foreach (var pool in pools)
        {
            <div @key="pool.Id">
                <h3>@pool.ProviderId · @pool.State</h3>
                <p>Remaining allowance: unknown</p>
                <p class="meta">Affected workers: @string.Join(", ", (snapshot?.Workers ?? []).Where(x => x.ProviderId == pool.ProviderId && !x.Archived).Select(x => x.Name))</p>
                @if (pool.RetryAt is { } retry) { <p>Retry no earlier than @DateTimeOffset.FromUnixTimeMilliseconds(retry).ToString("u")</p> }
                @if (pool.State != "Available")
                {
                    <button disabled="@(busy || !recoveryVerified)" @onclick="() => ResumePool(pool)">Resume @pool.ProviderId dispatch</button>
                }
            </div>
        }
        @if (pools.Any(x => x.State != "Available"))
        {
            <label><input type="checkbox" @bind="recoveryVerified" /> I verified provider access and available allowance</label>
            <p class="meta">Resuming permits queued instructions. It does not replay failed tasks or purchase additional access.</p>
        }
    </section>
    <section class="panel" aria-label="OpenCode Go key">
        <h2>OpenCode Go</h2>
        <p>Save your subscription API key encrypted on AgentHost, then apply it to selected runtimes. The saved key is never shown again. OpenCode stores its own credential copy on each selected runtime.</p>
        <p role="status">@(keyStatus?.Saved == true ? "Key saved · revision " + keyStatus.Revision : "No key saved")</p>
        <label for="go-api-key">OpenCode Go API key</label>
        <input id="go-api-key" type="password" autocomplete="new-password" maxlength="8192" @bind="apiKey" @bind:event="oninput" />
        <button disabled="@(busy || string.IsNullOrWhiteSpace(apiKey))" @onclick="SaveKey">Save encrypted key</button>
        <p class="meta">Saving does not change models or resume work. Subscription allowance is checked separately; saving a key does not verify available quota.</p>
    </section>
    <section class="panel">
        <h2>ChatGPT subscription</h2>
        <p>Choose a runtime, open the sign-in link and enter its device code. No port forwarding is needed. All workers running as the same OS user on that runtime share its OpenCode credentials.</p>
        <p>Credentials stay on the runtime. Sign-in does not change worker models or interrupt tasks. After signing in, refresh workspace models in the worker editor and select a model for future instructions.</p>
        <p>You can navigate away while approval is pending. If AgentHost restarts, pending sign-in tracking is lost; check the runtime before starting again.</p>
    </section>
    @foreach (var runtime in snapshot?.Runtimes ?? [])
    {
        var login = logins.FirstOrDefault(x => x.RuntimeId == runtime.Id);
        var pending = login?.State is "Starting" or "Waiting";
        <section class="panel" @key="runtime.Id">
            <h2>@runtime.Name</h2>
            <p class="meta">@runtime.Health · @runtime.Username@@@runtime.Host</p>
            @if (login is not null)
            {
                <p role="status"><strong>@login.State</strong> · @login.Detail</p>
                @if (login.State == "Waiting")
                {
                    <p><a href="@login.Url" target="_blank" rel="noopener noreferrer">Open ChatGPT device sign-in</a></p>
                    <p>Device code: <code class="device-code">@login.Code</code></p>
                    <p class="meta">Approve promptly; the device code can expire. Tracking continues for up to ten minutes.</p>
                }
            }
            <button disabled="@(busy || pending || !runtime.DesiredConnected || runtime.Health != "Healthy")" @onclick="() => Start(runtime.Id)">@(pending ? "Sign-in pending…" : login?.State == "Connected" ? "Sign in again" : "Sign in with ChatGPT")</button>
            <button disabled="@(busy || keyStatus?.Saved != true || !runtime.DesiredConnected || runtime.Health != "Healthy")" @onclick="() => ApplyKey(runtime.Id)">Apply saved Go key</button>
            @if (keyStatus?.Deliveries.FirstOrDefault(x => x.RuntimeId == runtime.Id) is { } delivery)
            {
                <p class="meta">Go key revision @delivery.KeyRevision · @(delivery.KeyRevision != keyStatus.Revision ? "Saved key changed; apply the latest revision." : delivery.State == "StoredOnRuntime" ? "Stored by OpenCode. Model access and allowance not yet tested." : delivery.State == "FailedBeforeSend" ? "Connection failed before sending. Retry when the runtime is available." : "Delivery unconfirmed. Applying again safely replaces the same provider key.")</p>
            }
            @if (runtime.Health != "Healthy") { <p class="meta">Verify and connect this runtime first.</p> }
        </section>
    }
</div>
