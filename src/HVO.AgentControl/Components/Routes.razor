@* Static SSR routing. No interactive render mode is requested, so the page is
   rendered on the server and hydrated by the external terminal module only. *@
<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <p class="route-fallback" role="alert">No AgentControl page matches this address.</p>
    </NotFound>
</Router>
